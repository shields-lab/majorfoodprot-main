# Large, fully regenerable via the pipeline scripts in fooddb-code
proteomes/
subproteomes/OrthoFinder/
output_tsvs/very_redundant/
output_tsvs/diamond_mappings/
output_tsvs/redundant/
uniprot_records/

# OrthoFinder run log (stdout redirect -- filename is picked per invocation,
# e.g. orthofinder_run_25Oct26.log) and ete3's NCBI taxonomy download
# byproduct (build_species_tree.py, Step 5) -- both regenerable, neither
# meant to be committed
orthofinder_run_*.log
taxdump.tar.gz

# red_orthologs.py's dense-family-fallback scratch DIAMOND run (Step 7) — hits.tsv
# alone is multi-GB (its query/db cover every member of every orthogroup with a
# tagged reference, not just the references). fallback_decisions.tsv (the audit
# log) and ambiguous_paralogs_review.tsv (a derived review report) are the only
# outputs worth keeping; everything else here regenerates from a re-run.
orthologs/dense_family_fallback/query.fa
orthologs/dense_family_fallback/reference.fa
orthologs/dense_family_fallback/search_targets.fa
orthologs/dense_family_fallback/hits.tsv
orthologs/dense_family_fallback/*.dmnd

# Unused legacy duplicates (only Homo_sapiens.fa is referenced by the input TSV)
query_fasta_files/Homo_sapiens.fasta
query_fasta_files/Homo_sapiens_proteome.fasta

# Legacy data from an earlier, different analysis approach — unrelated to
# the current get_*.py / red_orthologs.py / nonred_orthologs.py pipeline
blast_fasta_files/

.DS_Store
nohup.out
