# One directory per numbered release: releases/<version>/ (see UPDATING.md).
# Inside each, large regenerable output stays local and is shared as GitHub
# Release assets / on Zenodo instead of being committed.

# Proteomes and everything derived from them (Steps 2-4, 6)
releases/*/proteomes/
releases/*/homologs/
releases/*/subproteomes/
releases/*/uniprot_records/

# Step 3-4 per-species intermediates
releases/*/output_tsvs/very_redundant/
releases/*/output_tsvs/diamond_mappings/
releases/*/output_tsvs/redundant/

# Steps 7-8 intermediates and derived (sequence-bearing) views of the database:
# fooddb.sqlite (~56 MB), red/nonred_orthologs.tsv and .fa are in the Zenodo
# record for each release; the deliverable TSV is what gets committed.
releases/*/output_tsvs/fooddb.sqlite
releases/*/output_tsvs/red_orthologs.tsv
releases/*/output_tsvs/nonred_orthologs.tsv
releases/*/orthologs/red_orthologs.fa
releases/*/orthologs/nonred_orthologs.fa
releases/*/orthologs/cdhit_tmp/
releases/*/orthologs/diamond_tmp/
# dense-family-fallback scratch DIAMOND run (hits.tsv alone is multi-GB);
# fallback_decisions.tsv (the audit log) is kept
releases/*/orthologs/dense_family_fallback/query.fa
releases/*/orthologs/dense_family_fallback/reference.fa
releases/*/orthologs/dense_family_fallback/search_targets.fa
releases/*/orthologs/dense_family_fallback/hits.tsv
releases/*/orthologs/dense_family_fallback/*.dmnd

# an input TSV saved in the main directory for a run (the committed copy is the one
# `run_release.sh` makes inside releases/<version>/)
/*.tsv

# resume markers and the whole-run log written by run_release.sh
releases/*/.steps_done/
releases/*/run_release.log

# OrthoFinder run log (stdout redirect, e.g. orthofinder_run_25Oct26.log)
# and ete3's NCBI taxonomy download byproduct (Step 5)
orthofinder_run_*.log
taxdump.tar.gz

# Legacy data from an earlier, different analysis approach
blast_fasta_files/

.DS_Store
nohup.out

# duplicate legacy FASTAs (only Homo_sapiens.fa is referenced by the input TSV)
releases/*/query_fasta_files/Homo_sapiens.fasta
releases/*/query_fasta_files/Homo_sapiens_proteome.fasta
