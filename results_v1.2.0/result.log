2 things had to be fixed

1) In input some rows  requiring fasta sequences , were in .fa and some in .fasta.

So I chamged the Food_peptide_databases-input.tsv

2) After running orthofinder, subproteomes/OrthoFinder/Results_Oct25/Orthologues  had files in .gz format.  For next steps files were neeeded in .tsv so I unzipped them with

python - <<'PY'
from pathlib import Path
import gzip
import shutil

results = Path("subproteomes/OrthoFinder/Results_Oct25")
source = results / "Orthologs"
destination = results / "Orthologues"

files = sorted(source.glob("*.tsv.gz"))
if not files:
    raise SystemExit(f"No .tsv.gz files found in {source}")

destination.mkdir(exist_ok=True)
created = 0

for compressed in files:
    output = destination / compressed.stem

    if output.exists():
        print(f"Already exists; left unchanged: {output.name}")
        continue

    with gzip.open(compressed, "rb") as reader:
        with output.open("xb") as writer:
            shutil.copyfileobj(reader, writer)

    created += 1

print(f"\nCreated {created} uncompressed tables in {destination}")
PY

